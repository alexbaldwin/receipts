[Unit]
Description=Receipt thermal printer HTTP server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=alexbaldwin
Group=alexbaldwin
SupplementaryGroups=lp
WorkingDirectory=/home/alexbaldwin/receipts
EnvironmentFile=/etc/receipt-printer/server.env
ExecStart=/home/alexbaldwin/receipts/.venv/bin/receipt-server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
