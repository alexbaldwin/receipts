# HTTP server
RECEIPT_SERVER_HOST=0.0.0.0
RECEIPT_SERVER_PORT=8080

# Use "network" for Ethernet/Wi-Fi printer access or "usb" for USB.
THERMAL_PRINTER_CONNECTION=usb

# Network printer settings
THERMAL_PRINTER_IP=192.168.2.2
THERMAL_PRINTER_PORT=9100

# USB printer settings.
# Find these with: lsusb
# Example lsusb output contains "04b8:0202"; vendor is 0x04b8, product is 0x0202.
# THERMAL_PRINTER_CONNECTION=usb
# THERMAL_PRINTER_USB_VENDOR_ID=0x04b8
# THERMAL_PRINTER_USB_PRODUCT_ID=0x0202
# THERMAL_PRINTER_USB_IN_ENDPOINT=0x82
# THERMAL_PRINTER_USB_OUT_ENDPOINT=0x01
# THERMAL_PRINTER_USB_TIMEOUT=0
# Optional. When set, POST /print needs 'Authorization: Bearer <key>' or 'X-API-Key: <key>'.
# RECEIPT_API_KEY=change-me
